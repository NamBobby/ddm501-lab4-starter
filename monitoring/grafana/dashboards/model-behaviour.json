{
  "__inputs": [],
  "__requires": [],
  "uid": "ddm501-model",
  "title": "DDM501 \u2014 Model Behaviour",
  "description": "Input drift, output scores, decision mix, fairness and model diagnostics.",
  "tags": [
    "ddm501",
    "lab04",
    "model"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Drift score (max PSI)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ddm501"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ml_drift_score{job=\"credit-risk-api\"}",
          "legendFormat": "PSI",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ddm501"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Monitoring window (minimum 200)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
